# Database
DATABASE_URL=postgresql://slidepresenter:slidepresenter@localhost:5432/slidepresenter

# S3 / MinIO (local development)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=slidepresenter-files
S3_ENDPOINT_URL=http://localhost:9000

# Google OAuth (optional - get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
APP_SECRET_KEY=your-secret-key-change-in-production
